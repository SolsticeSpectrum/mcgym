# copy to .env and fill in, compose fails fast on the required values

# ssh public keys allowed to log in, separate multiple keys with ;
SSH_PUBLIC_KEYS=ssh-ed25519 AAAA...your-key... you@example.com
# container user password, web desktop login and sudo-root inside
PASSWD=change-me
# repo to clone on launch, private repo needs a github pat with read access,
# REPO_URL=https://<token>@github.com/SolsticeSpectrum/mcai.git
REPO_URL=https://github.com/SolsticeSpectrum/mcai.git

# host dir mounted as /drive2, the only storage surviving recreates
DATA_DIR=/data/Docker/data
# which gpu the container gets (nvidia-smi index)
GPU_ID=2
# raising these buys training throughput directly if the host has headroom
CPUS=12
MEM_LIMIT=64g

# training knobs, defaults are the tuned rtx 6000 config
#TASK=wood
#NUM_ENVS=32
#AGENTS=64
#ROLLOUT=128
#MINIBATCH=16384
#EPOCHS=2
#COHORTS=4
#SCALE=3
#MONITOR_PORT=9080
