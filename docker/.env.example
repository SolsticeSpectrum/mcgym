# Copy to .env (same folder) and fill in. compose fails fast if the required
# values are missing.

# --- required ---------------------------------------------------------------
# SSH public keys authorized to log in (separate multiple keys with ';')
SSH_PUBLIC_KEYS=ssh-ed25519 AAAA...your-key... you@example.com
# Container user password (web desktop login + `sudo-root` inside)
PASSWD=change-me
# Repo to clone on launch. PRIVATE repo -> embed a GitHub fine-grained PAT
# with read-only Contents permission on this repo:
#   REPO_URL=https://<token>@github.com/SolsticeSpectrum/mcai.git
REPO_URL=https://github.com/SolsticeSpectrum/mcai.git

# --- host layout ------------------------------------------------------------
# Host dir mounted as /drive2 (the ONLY storage surviving container recreates)
DATA_DIR=/data/Docker/data
# Which GPU the container gets (nvidia-smi index)
GPU_ID=2
# CPU/memory caps. NOTE: the trainer's rollout buffers alone need ~21 GB at the
# default 2048 agents — raising MEM_LIMIT (and CPUS) directly buys training
# throughput if the host has headroom.
CPUS=12
MEM_LIMIT=64g

# --- training knobs (optional; defaults are the tuned RTX 6000 config) -------
#TASK=wood
#NUM_ENVS=32
#AGENTS=64
#ROLLOUT=128
#MINIBATCH=16384
#EPOCHS=2
#COHORTS=4
#SCALE=3
#MONITOR_PORT=9080
